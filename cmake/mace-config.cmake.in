@PACKAGE_INIT@

# Find dependencies
include(CMakeFindDependencyMacro)

# Find libtorch with the same version preference that was used to build mace
set(MACE_USE_SYSTEM_TORCH @MACE_USE_SYSTEM_TORCH@)
set(MACE_TORCH_VERSION "@MACE_TORCH_VERSION@")

find_dependency(Torch REQUIRED)

# Set flag to indicate whether Fortran support was built
set(MACE_HAS_FORTRAN @MACE_BUILD_FORTRAN@)
set(MACE_FORTRAN_MODULE "${CMAKE_CURRENT_LIST_DIR}/../../../include/mace.f90")

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/mace-targets.cmake")

# Define installation information validation
check_required_components(mace)
